{
  "name": "s-learning",
  "version": "1.0.0",
  "private": true,
  "description": "S Learning: Next.js + TypeScript + Prisma + PostgreSQL learning and earnings platform with CMS and a mobile-ready REST API",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-open-ebooks": "node --env-file=.env --import tsx scripts/import-open-ebooks.ts",
    "storage:migrate": "node --env-file=.env --import tsx scripts/migrate-to-supabase-storage.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^15.5.27",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "6.19.0",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
