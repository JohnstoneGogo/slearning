# Copy this file to .env and fill in the values before running the app.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:root@localhost:5432/slearning

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me-to-at-least-32-chars

# ── App ───────────────────────────────────────────────────────────────────────
# Public HTTPS URL of your deployment (no trailing slash). Required in production.
APP_URL=http://localhost:3000

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Leave blank to run in mock mode (no real money moves).
PAYSTACK_SECRET_KEY=
# Set to "mock" to force mock mode even when a key is present (useful for staging).
# PAYMENT_PROVIDER=mock

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Required in production. Example: smtps://user:pass@smtp.provider.com
SMTP_URL=
MAIL_FROM=S Learning <no-reply@example.com>

# ── Redis (optional but recommended for multi-instance deployments) ────────────
# Falls back to in-process memory when not set (single instance only).
# REDIS_URL=redis://localhost:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API (mobile app, etc.).
# Leave blank to allow same-origin only in production.
# CORS_ORIGIN=https://your-mobile-app-origin.com

# ── Admin seed credentials (used by npm run db:seed only) ─────────────────────
# Set all three explicitly before seeding. Use a unique ADMIN_PASSWORD of at least 16 characters.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cron (serverless deployments) ─────────────────────────────────────────────
# Set a long random secret and call GET /api/v1/cron/reconcile every minute
# with "Authorization: Bearer $CRON_SECRET".
# CRON_SECRET=

# ── Dev only ──────────────────────────────────────────────────────────────────
# Set to "true" to enable the /dev/payments/:ref/succeed endpoint (never in production).
# ENABLE_DEV_ROUTES=true

# ── File uploads ──────────────────────────────────────────────────────────────
# Absolute path to the uploads directory. Defaults to ./uploads in the project root.
# In production, point this outside the repo and back it up separately.
# UPLOAD_DIR=/var/data/s-learning/uploads
